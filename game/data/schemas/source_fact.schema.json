{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Source Fact",
  "description": "A factual claim backed by a source with confidence and verification",
  "type": "object",
  "required": ["id", "claim", "source_type", "confidence"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique slug"
    },
    "claim": {
      "type": "string",
      "description": "The factual claim"
    },
    "source_type": {
      "type": "string",
      "enum": ["wiki", "reddit", "screenshot", "spreadsheet", "reverse_engineering", "ocr", "player_report"],
      "description": "Type of source"
    },
    "source_url": {
      "type": ["string", "null"],
      "description": "URL of the source, if available"
    },
    "source_file": {
      "type": ["string", "null"],
      "description": "Local file reference"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Confidence score from 0.0 to 1.0"
    },
    "verified_by": {
      "type": ["string", "null"],
      "description": "Who verified this fact"
    },
    "verified_at": {
      "type": ["string", "null"],
      "format": "date",
      "description": "Verification date"
    },
    "related_entities": {
      "type": "array",
      "items": { "type": "string" },
      "description": "IDs of related entities"
    },
    "notes": {
      "type": ["string", "null"]
    }
  }
}
