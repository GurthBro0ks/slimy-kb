{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bot Answer Chunk",
  "description": "A pre-written answer chunk for the Discord bot to use when matching questions",
  "type": "object",
  "required": ["id", "question_pattern", "answer_text", "last_updated"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique slug"
    },
    "question_pattern": {
      "type": "string",
      "description": "Regex or keyword pattern this chunk answers"
    },
    "answer_text": {
      "type": "string",
      "description": "The answer text"
    },
    "entity_refs": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Entity IDs referenced in the answer"
    },
    "source_facts": {
      "type": "array",
      "items": { "type": "string" },
      "description": "IDs of source facts backing this answer"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Confidence score from 0.0 to 1.0"
    },
    "last_updated": {
      "type": "string",
      "format": "date",
      "description": "Last update date"
    }
  }
}
